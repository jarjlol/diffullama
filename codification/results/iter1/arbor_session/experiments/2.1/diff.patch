+    counts = collections.Counter(a for a in answers if a is not None)
+    if not counts:
         return 0
-    return min(scored)[1]
+
+    top = max(counts.values())
+    tied = {a for a, cnt in counts.items() if cnt == top}
+    if len(tied) == 1:
+        winner = next(iter(tied))
+        return next(i for i, a in enumerate(answers) if a == winner)
+
+    # Tied for the top count: best (min) per-token qwen7b NLL per tied answer.
+    best = {}
