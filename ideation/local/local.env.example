# Env file for running the ideation pipeline against the local vLLM servers.
# Copy to ~/.ideation-local-env and chmod 600 (daily_run.sh refuses other modes).
# No secrets here: vLLM was started without --api-key, so any non-empty key works.
export LLM_BASE_URL=http://127.0.0.1:8000/v1
export LLM_API_KEY=local
export LLM_MODEL=ideation-gen
export REVIEWER_BASE_URL=http://127.0.0.1:8001/v1
export REVIEWER_API_KEY=local
export REVIEWER_MODEL=ideation-rev
# A local reasoning model can need longer than a hosted API's 300 s.
export LLM_TIMEOUT=900
# Optional: turn the generator's thinking off if the probe shows it is too slow.
# export LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
